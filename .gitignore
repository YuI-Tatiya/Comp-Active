# === Dependencies (ติดตั้งได้ใหม่ด้วย npm install) ===
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# === Environment Variables (เก็บ secrets — ห้าม push เด็ดขาด) ===
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
.env.development.local
.env.test.local
.env.production.local
# หมายเหตุ: .env.example ยังคง push ได้ เพราะเป็นแค่ตัวอย่างไม่มี secret จริง

# === Build Output (สร้างได้ใหม่ด้วย npm run build) ===
dist/
out/
build/
.next/

# === TypeScript Cache (สร้างใหม่อัตโนมัติ) ===
*.tsbuildinfo
next-env.d.ts

# === Uploaded Files (ไฟล์ที่ user อัปโหลด ไม่ควรอยู่ใน repository) ===
backend/public/uploads/
# หมายเหตุ: โฟลเดอร์ uploads/ จะถูกสร้างอัตโนมัติเมื่อรัน backend ครั้งแรก

# === Generated Prisma Client (สร้างใหม่ด้วย prisma generate — ซ้ำกับ backend/.gitignore เผื่อไฟล์นั้นหาย) ===
backend/generated/

# === Test Coverage ===
coverage/

# === OS Files ===
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# === IDE / Editor (ใช้ IDE ต่างกันในทีม ไม่ควรบังคับ config) ===
.idea/
.vscode/
*.swp
*.swo
*~

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Certificates / Keys ===
*.pem
*.key
*.crt
*.pfx
*.p12

# === Database Dumps (มีข้อมูลนักศึกษาจริงและ hash รหัสผ่าน — ห้ามขึ้น repo เด็ดขาด) ===
*.sql
*.dump
*.sqlite
*.sqlite3
!backend/prisma/migrations/**/*.sql
# สคริปต์ซ่อมข้อมูลที่เขียนเอง (ไม่มีข้อมูลจริง) — migrate.sh รันทุกไฟล์ในโฟลเดอร์นี้ ห้ามวาง dump ไว้ที่นี่
!backend/prisma/backfills/*.sql

# === Merge / Backup Artifacts (เกิดตอนแก้ conflict หรือสำรองไฟล์ก่อนแก้) ===
*.bak
*.orig
*.rej
*.tmp

# === Claude Code (ค่า config ส่วนตัวของแต่ละคน — .claude/settings.json ที่แชร์กันยัง push ได้) ===
.claude/settings.local.json
.claude/*.local.json

# === Vercel ===
.vercel

# === Misc ===
.cache/
tmp/
temp/
.worktrees/
