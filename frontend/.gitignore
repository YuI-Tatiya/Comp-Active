# ============================================================
#  Frontend .gitignore (Next.js)
# ============================================================

# === Dependencies ===
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# === Next.js Build & Cache ===
/.next/
/out/
/build

# === Environment Variables (ห้าม push) ===
.env
.env.local
.env.production
.env.staging
.env.test
.env.development.local
.env.test.local
.env.production.local
# .env.example → push ได้

# === TypeScript ===
*.tsbuildinfo
next-env.d.ts

# === Test Coverage ===
/coverage

# === Vercel (deploy config ส่วนตัว) ===
.vercel

# === Logs ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === OS Files ===
.DS_Store
Thumbs.db
desktop.ini

# === IDE ===
.idea/
.vscode/
*.swp
*~

# === Certificates ===
*.pem
