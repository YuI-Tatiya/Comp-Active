# For `docker compose up` (Nginx gateway): the page calls /api and /uploads on its own
# host (app.localhost / admin.localhost) and Nginx forwards them to the backend, so the
# session cookie is first-party. Do not point this at api.localhost — that makes the
# cookie third-party and Brave/Safari drop or partition it.
NEXT_PUBLIC_API_URL=same-origin

# For bare `npm run dev` without Nginx, use instead:
# NEXT_PUBLIC_API_URL=http://localhost:3001

# ตั้งเป็น true "หลังจาก" ติดตั้ง TLS ที่ nginx แล้วเท่านั้น
# เปิด HSTS + upgrade-insecure-requests ใน next.config.ts
# ถ้าเปิดตอนที่ยังเป็น http อยู่ browser จะอัป request เป็น https แล้วยิงไม่ติดทั้งระบบ
ENABLE_HTTPS=false

# โฮสต์ที่ proxy.ts ยอมให้เข้าโซนแอดมิน (คั่นด้วยจุลภาค)
ADMIN_HOSTS=admin.localhost
