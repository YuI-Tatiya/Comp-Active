# Server
PORT=3001
NODE_ENV=development

# การปรับ schema ฐานข้อมูล (ใช้โดย service `migrate` ใน docker-compose)
# ค่าปกติ false = ถ้าการเปลี่ยน schema จะทำให้ข้อมูลเดิมหาย ให้ล้มไปเลย backend จะไม่สตาร์ท
# ตั้งเป็น true เฉพาะตอนที่ตั้งใจจะยอมให้ข้อมูลหายจริง ๆ แล้วรีบเปลี่ยนกลับ
# (ของเดิม entrypoint.sh ใส่ --accept-data-loss ไว้ตายตัว = ข้อมูลหายเงียบ ๆ ได้ทุกครั้งที่สตาร์ท)
PRISMA_ACCEPT_DATA_LOSS=false

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/compactive_db"

# Admin Seed
ADMIN_EMAIL=your email for admin account
ADMIN_PASSWORD=your password for admin account

# Session cookie
# JWT ถูกส่งกลับเป็น httpOnly cookie (JavaScript อ่านไม่ได้ = XSS ขโมย session ไม่ได้)
#
# ค่าปกติคือ lax ซึ่งถูกต้องสำหรับโดเมนจริง (app.compactive.com กับ api.compactive.com
# เป็น same-site) แต่ตอน dev ที่ใช้ *.localhost เบราว์เซอร์อาจนับเป็นคนละ site
# อาการคือ "ล็อกอินผ่านแต่เด้งกลับหน้า login ทันที" — ถ้าเจอให้เปลี่ยนเป็น none
AUTH_COOKIE_SAMESITE=lax

# JWT
# บังคับ: ต้องยาว >= 32 ตัวอักษร และห้ามเป็นค่าตัวอย่างนี้ ระบบจะไม่ยอมบูตถ้าไม่ผ่าน
# สร้างค่าสุ่ม: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS + redirects). docker-compose.yml overrides this to
# http://app.localhost for the Nginx-gateway workflow — this default is for bare `npm run start:dev`.
FRONTEND_URL=http://localhost:3000
# Admin subdomain frontend URL (for CORS + invite links). docker-compose.yml overrides
# this to http://admin.localhost for the Nginx-gateway workflow.
ADMIN_FRONTEND_URL=http://admin.localhost:3000

# Admin invite links expire after this many hours
ADMIN_INVITE_EXPIRES_HOURS=48

# Admin IP/VPN allowlist — inert hook, off by default. When enabled, ADMIN_IP_ALLOWLIST
# must be set (comma-separated IPs/CIDRs) and TRUST_PROXY_HOPS tuned to your reverse proxy.
ADMIN_IP_ALLOWLIST_ENABLED=false
ADMIN_IP_ALLOWLIST=
TRUST_PROXY_HOPS=1

# Email (Resend — HTTPS API, ไม่ใช่ SMTP ดิบ) — ขอ API key ได้ที่ resend.com/api-keys
# เหตุผลที่ไม่ใช้ SMTP: หลาย PaaS (ยืนยันแล้วบน Railway) บล็อกพอร์ต SMTP ขาออกโดยดีฟอลต์เพื่อกันสแปม
# ทำให้การส่งอีเมลค้างจน timeout แทนที่จะถูกปฏิเสธทันที Resend คุยผ่าน HTTPS พอร์ต 443 ธรรมดาจึงไม่โดน
RESEND_API_KEY=
# ต้อง verify โดเมนของอีเมลนี้กับ Resend ก่อน ถึงจะส่งถึงผู้รับทั่วไปได้จริง (ไม่ใช่แค่ sandbox)
MAIL_FROM=Comp Active <no-reply@cpc.kku.ac.th>

# Chatbot (มาสคอตตอบคำถามพื้นฐาน) — ใช้ KKU IntelSphere (https://gen.ai.kku.ac.th)
# เกตเวย์นี้เข้ากันได้กับ OpenAI Chat Completions API — ขอ API key ได้ที่ gen.ai.kku.ac.th/chat
# ไม่ตั้งค่านี้ไว้ แชทบอทจะตอบข้อความแจ้งว่ายังไม่เปิดใช้งานแทน (ไม่ทำให้ระบบส่วนอื่นพังหรือบูตไม่ขึ้น)
CHATBOT_API_KEY=
# เปลี่ยน base URL/โมเดลได้โดยไม่ต้องแก้โค้ด เผื่อย้ายไปใช้เกตเวย์ที่เข้ากันได้กับ OpenAI เจ้าอื่น
CHATBOT_BASE_URL=https://gen.ai.kku.ac.th/api/v1
CHATBOT_MODEL=gemini-2.5-flash-lite

# Cloudflare R2 (ที่เก็บไฟล์อัปโหลด: รูปกิจกรรม, เอกสารแนบ) — ไม่ตั้งค่าชุดนี้เลย = ตกกลับไปเขียนไฟล์
# ลงดิสก์ที่ backend/public/uploads เหมือนเดิม (ใช้ได้เฉพาะเครื่องที่มีดิสก์ถาวร เช่น dev/VPS ของตัวเอง)
# ต้องตั้งให้ครบทั้ง 5 ตัวเมื่อ deploy ไปที่ที่ไม่มีดิสก์ถาวรข้าม deploy (เช่น Railway)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# โดเมนสาธารณะของ bucket (R2.dev หรือ custom domain ที่ผูกไว้) — ไม่มี / ท้าย
R2_PUBLIC_URL=
