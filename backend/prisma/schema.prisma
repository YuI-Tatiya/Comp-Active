generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RequestStatus {
  pending
  approved
  rejected
}

enum UserRole {
  student
  organizer
  admin
}

enum EducationLevel {
  bachelor
  master
  doctorate
}

enum ActivityStatus {
  open
  closed
  completed
}

enum ApprovalStatus {
  pending_approval
  approved
  rejected
  pending_cancel
  /// ผู้จัดยกเลิกกิจกรรมของตัวเอง — แยกจาก rejected (แอดมิน/ระบบปฏิเสธ) เพื่อไม่ให้
  /// นักศึกษาสับสนว่าใครเป็นคนยกเลิก (ดู ActivitiesService.requestCancellation)
  cancelled
}

enum RegistrationStatus {
  pending
  confirmed
  cancelled
}

enum AttendanceStatus {
  attended
  absent
}

enum InviteStatus {
  pending
  accepted
  revoked
}

enum SoftSkillType {
  communication
  time_management
  flexibility_adaptability
  teamwork_collaboration
  analytic_critical_thinking
  decision_making
  creativity
  complex_problem_solving
  curiosity_lifelong_learning
  negotiation_persuasion
  leadership
  positive_attitude
}

enum EventVisibility {
  everyone
  restricted
}

enum ActivityQuestionType {
  text
  single_choice
  multi_choice
}

enum SurveyQuestionType {
  rating
  text
}

// ─── Models ──────────────────────────────────────────────────────────────────

model OrganizerRequest {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(255)
  email           String        @db.VarChar(255)
  phone           String        @db.VarChar(20)
  department      String        @db.VarChar(255)
  reason          String
  experience      String?
  status          RequestStatus @default(pending)
  rejectionReason String?       @map("rejection_reason")
  validDays       Int?          @map("valid_days")
  approvedById    Int?          @map("approved_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  approvedBy User? @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("organizer_requests")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  studentId String? @map("student_id") @db.VarChar(20)

  // ── ข้อมูลติดต่อ & การศึกษา ────────────────────────────────────────────────
  // nullable ทั้งหมด เพราะ admin/organizer ไม่มีข้อมูลส่วนนี้
  // และ user ที่สมัครก่อนฟีเจอร์นี้ก็ยังไม่มีข้อมูล — บังคับกรอกที่ชั้น DTO แทน
  phone          String?         @db.VarChar(20)
  educationLevel EducationLevel? @map("education_level")
  program        String?         @db.VarChar(50) // เก็บ code จาก common/constants/programs.ts

  email                    String    @unique @db.VarChar(255)
  password                 String    @db.VarChar(255)
  username                 String?   @unique @db.VarChar(50)
  role                     UserRole  @default(student)
  validUntil               DateTime? @map("valid_until")
  createdAt                DateTime  @default(now()) @map("created_at")
  isBlocked                Boolean   @default(false) @map("is_blocked")
  verificationOtp          String?   @map("verification_otp") @db.VarChar(10)
  verificationOtpExpiresAt DateTime? @map("verification_otp_expires_at")

  events                    Event[]
  activities                Activity[]
  registrations             Registration[]
  evaluations               Evaluation[]
  sentAdminInvites          AdminInvite[]
  approvedOrganizerRequests OrganizerRequest[]
  apiKeys                   ApiKey[]
  updatedSiteContents       SiteContent[]

  @@map("users")
}

model AdminInvite {
  id          Int          @id @default(autoincrement())
  email       String       @db.VarChar(255)
  tokenHash   String       @unique @map("token_hash") @db.VarChar(64)
  status      InviteStatus @default(pending)
  invitedById Int?         @map("invited_by_id")
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@map("admin_invites")
}

model Event {
  id                        Int             @id @default(autoincrement())
  organizerId               Int             @map("organizer_id")
  name                      String          @db.VarChar(255)
  description               String
  imageUrl                  String?         @map("image_url") @db.VarChar(500)
  isPublic                  Boolean         @default(true) @map("is_public")
  registrationCloseAt       DateTime?       @map("registration_close_at")
  visibility                EventVisibility @default(everyone)
  visibilityStudentIdFilter String?         @map("visibility_student_id_filter")
  createdAt                 DateTime        @default(now()) @map("created_at")

  organizer         User                     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  activities        Activity[]
  surveyQuestions   EventSurveyQuestion[]
  visibilityProgram EventVisibilityProgram[]
  visibilityYears   EventVisibilityYear[]

  @@map("events")
}

model EventVisibilityProgram {
  id          Int    @id @default(autoincrement())
  eventId     Int    @map("event_id")
  programCode String @map("program_code") @db.VarChar(50)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_visibility_programs")
}

model EventVisibilityYear {
  id      Int @id @default(autoincrement())
  eventId Int @map("event_id")
  year    Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_visibility_years")
}

model Activity {
  id                 Int            @id @default(autoincrement())
  organizerId        Int            @map("organizer_id")
  eventId            Int?           @map("event_id")
  name               String         @db.VarChar(255)
  description        String
  category           String         @db.VarChar(100)
  date               DateTime       @db.Date
  startTime          String         @map("start_time") @db.VarChar(10)
  endTime            String         @map("end_time") @db.VarChar(10)
  startAt            DateTime?      @map("start_at")
  endAt              DateTime?      @map("end_at")
  location           String         @db.VarChar(255)
  capacity           Int?
  status             ActivityStatus @default(open)
  approvalStatus     ApprovalStatus @default(pending_approval) @map("approval_status")
  rejectionReason    String?        @map("rejection_reason")
  cancellationReason String?        @map("cancellation_reason")
  imageUrl           String?        @map("image_url") @db.VarChar(500)
  attachmentUrl      String?        @map("attachment_url") @db.VarChar(500)
  volunteerHours     Decimal?       @map("volunteer_hours") @db.Decimal(5, 2)
  volunteerRole      String?        @map("volunteer_role") @db.VarChar(255)
  createdAt          DateTime       @default(now()) @map("created_at")

  organizer     User                @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  event         Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tags          ActivityTag[]
  conditions    ActivityCondition[]
  benefits      ActivityBenefit[]
  softSkills    ActivitySoftSkill[]
  questions     ActivityQuestion[]
  registrations Registration[]

  @@map("activities")
}

model ActivityTag {
  id         Int    @id @default(autoincrement())
  activityId Int    @map("activity_id")
  tagName    String @map("tag_name") @db.VarChar(100)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_tags")
}

model ActivityCondition {
  id            Int    @id @default(autoincrement())
  activityId    Int    @map("activity_id")
  conditionText String @map("condition_text")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_conditions")
}

model ActivityBenefit {
  id          Int    @id @default(autoincrement())
  activityId  Int    @map("activity_id")
  benefitText String @map("benefit_text")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_benefits")
}

model ActivitySoftSkill {
  id         Int           @id @default(autoincrement())
  activityId Int           @map("activity_id")
  skillType  SoftSkillType @map("skill_type")
  rate       Int           @default(1)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_soft_skills")
}

model Registration {
  id           Int                @id @default(autoincrement())
  activityId   Int                @map("activity_id")
  studentId    Int                @map("student_id")
  registerDate DateTime           @default(now()) @map("register_date")
  status       RegistrationStatus @default(pending)
  attendance   AttendanceStatus   @default(absent)
  checkInTime  DateTime?          @map("check_in_time")
  // ขอใบจิตอาสาเพื่อ กยศ./ทุนการศึกษา — เลือกได้ทั้งสองอย่าง หรือไม่เลือกเลย (= ไม่ขอรับใบจิตอาสา)
  // มีความหมายเฉพาะกิจกรรมที่เปิดออกใบจิตอาสา (Activity.volunteerRole ไม่ว่าง)
  wantsCertLoanFund    Boolean @default(false) @map("wants_cert_loan_fund")
  wantsCertScholarship Boolean @default(false) @map("wants_cert_scholarship")

  activity      Activity                   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student       User                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificate   Certificate?
  evaluation    Evaluation?
  answers       RegistrationAnswer[]
  surveyAnswers RegistrationSurveyAnswer[]

  @@map("registrations")
}

// ─── กิจกรรม: คำถามสมัครแบบกำหนดเอง ────────────────────────────────────────────

model ActivityQuestion {
  id         Int                  @id @default(autoincrement())
  activityId Int                  @map("activity_id")
  label      String
  type       ActivityQuestionType
  required   Boolean              @default(false)
  sortOrder  Int                  @default(0) @map("sort_order")

  activity Activity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  options  ActivityQuestionOption[]
  answers  RegistrationAnswer[]

  @@map("activity_questions")
}

model ActivityQuestionOption {
  id         Int    @id @default(autoincrement())
  questionId Int    @map("question_id")
  label      String
  sortOrder  Int    @default(0) @map("sort_order")

  question ActivityQuestion           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  RegistrationAnswerOption[]

  @@map("activity_question_options")
}

model RegistrationAnswer {
  id             Int     @id @default(autoincrement())
  registrationId Int     @map("registration_id")
  questionId     Int     @map("question_id")
  textValue      String? @map("text_value")

  registration Registration               @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     ActivityQuestion           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  options      RegistrationAnswerOption[]

  @@unique([registrationId, questionId])
  @@map("registration_answers")
}

model RegistrationAnswerOption {
  id                   Int @id @default(autoincrement())
  registrationAnswerId Int @map("registration_answer_id")
  optionId             Int @map("option_id")

  registrationAnswer RegistrationAnswer     @relation(fields: [registrationAnswerId], references: [id], onDelete: Cascade)
  option             ActivityQuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@map("registration_answer_options")
}

// ─── งาน: แบบสำรวจความพึงพอใจหลังกิจกรรม ────────────────────────────────────────

model EventSurveyQuestion {
  id        Int                @id @default(autoincrement())
  eventId   Int                @map("event_id")
  label     String
  type      SurveyQuestionType
  scaleMax  Int                @default(5) @map("scale_max")
  sortOrder Int                @default(0) @map("sort_order")

  event   Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers RegistrationSurveyAnswer[]

  @@map("event_survey_questions")
}

model RegistrationSurveyAnswer {
  id             Int     @id @default(autoincrement())
  registrationId Int     @map("registration_id")
  questionId     Int     @map("question_id")
  ratingValue    Int?    @map("rating_value")
  textValue      String? @map("text_value")

  registration Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     EventSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, questionId])
  @@map("registration_survey_answers")
}

model Certificate {
  id               Int      @id @default(autoincrement())
  registrationId   Int      @unique @map("registration_id")
  issueDate        DateTime @default(now()) @map("issue_date")
  certificateUrl   String   @map("certificate_url") @db.VarChar(255)
  verificationCode String?  @unique @map("verification_code") @db.VarChar(20)
  volunteerHours   Decimal? @map("volunteer_hours") @db.Decimal(5, 2)
  volunteerRole    String?  @map("volunteer_role") @db.VarChar(255)

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  ownerId    Int       @map("owner_id")
  label      String    @db.VarChar(100)
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix  String    @map("key_prefix") @db.VarChar(12)
  rateLimit  Int       @default(60) @map("rate_limit")
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model SiteContent {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  title       String?  @db.VarChar(255)
  body        String?
  updatedById Int?     @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_contents")
}

model Evaluation {
  id                        Int      @id @default(autoincrement())
  registrationId            Int      @unique @map("registration_id")
  evaluatorId               Int      @map("evaluator_id")
  communication             Int      @default(0)
  timeManagement            Int      @default(0) @map("time_management")
  flexibilityAdaptability   Int      @default(0) @map("flexibility_adaptability")
  teamworkCollaboration     Int      @default(0) @map("teamwork_collaboration")
  analyticCriticalThinking  Int      @default(0) @map("analytic_critical_thinking")
  decisionMaking            Int      @default(0) @map("decision_making")
  creativity                Int      @default(0)
  complexProblemSolving     Int      @default(0) @map("complex_problem_solving")
  curiosityLifelongLearning Int      @default(0) @map("curiosity_lifelong_learning")
  negotiationPersuasion     Int      @default(0) @map("negotiation_persuasion")
  leadership                Int      @default(0)
  positiveAttitude          Int      @default(0) @map("positive_attitude")
  comment                   String?
  createdAt                 DateTime @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  evaluator    User         @relation(fields: [evaluatorId], references: [id])

  @@map("evaluations")
}
