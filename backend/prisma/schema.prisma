generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RequestStatus {
  pending
  approved
  rejected
}

enum UserRole {
  student
  organizer
  admin
}

enum ActivityStatus {
  open
  closed
  completed
}

enum ApprovalStatus {
  pending_approval
  approved
  rejected
  pending_cancel
}

enum RegistrationStatus {
  pending
  confirmed
  cancelled
}

enum AttendanceStatus {
  attended
  absent
}

enum InviteStatus {
  pending
  accepted
  revoked
}

// ─── Models ──────────────────────────────────────────────────────────────────

model OrganizerRequest {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(255)
  email           String        @db.VarChar(255)
  phone           String        @db.VarChar(20)
  department      String        @db.VarChar(255)
  reason          String
  experience      String?
  status          RequestStatus @default(pending)
  rejectionReason String?       @map("rejection_reason")
  validDays       Int?          @map("valid_days")
  approvedById    Int?          @map("approved_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  approvedBy User? @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("organizer_requests")
}

model User {
  id                       Int       @id @default(autoincrement())
  name                     String    @db.VarChar(255)
  studentId                String?   @map("student_id") @db.VarChar(20)
  email                    String    @unique @db.VarChar(255)
  password                 String    @db.VarChar(255)
  username                 String?   @unique @db.VarChar(50)
  role                     UserRole  @default(student)
  validUntil               DateTime? @map("valid_until")
  createdAt                DateTime  @default(now()) @map("created_at")
  isBlocked                Boolean   @default(false) @map("is_blocked")
  verificationOtp          String?   @map("verification_otp") @db.VarChar(10)
  verificationOtpExpiresAt DateTime? @map("verification_otp_expires_at")

  activities                Activity[]
  registrations             Registration[]
  evaluations               Evaluation[]
  sentAdminInvites          AdminInvite[]
  approvedOrganizerRequests OrganizerRequest[]
  apiKeys                   ApiKey[]
  updatedSiteContents       SiteContent[]

  @@map("users")
}

model AdminInvite {
  id          Int          @id @default(autoincrement())
  email       String       @db.VarChar(255)
  tokenHash   String       @unique @map("token_hash") @db.VarChar(64)
  status      InviteStatus @default(pending)
  invitedById Int?         @map("invited_by_id")
  expiresAt   DateTime     @map("expires_at")
  acceptedAt  DateTime?    @map("accepted_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@map("admin_invites")
}

model Activity {
  id                 Int            @id @default(autoincrement())
  organizerId        Int            @map("organizer_id")
  name               String         @db.VarChar(255)
  description        String
  category           String         @db.VarChar(100)
  date               DateTime       @db.Date
  startTime          String         @map("start_time") @db.VarChar(10)
  endTime            String         @map("end_time") @db.VarChar(10)
  location           String         @db.VarChar(255)
  capacity           Int
  status             ActivityStatus @default(open)
  approvalStatus     ApprovalStatus @default(pending_approval) @map("approval_status")
  rejectionReason    String?        @map("rejection_reason")
  cancellationReason String?        @map("cancellation_reason")
  imageUrl           String?        @map("image_url") @db.VarChar(500)
  createdAt          DateTime       @default(now()) @map("created_at")

  organizer     User                @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  tags          ActivityTag[]
  conditions    ActivityCondition[]
  benefits      ActivityBenefit[]
  softSkills    ActivitySoftSkill[]
  registrations Registration[]

  @@map("activities")
}

model ActivityTag {
  id         Int    @id @default(autoincrement())
  activityId Int    @map("activity_id")
  tagName    String @map("tag_name") @db.VarChar(100)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_tags")
}

model ActivityCondition {
  id            Int    @id @default(autoincrement())
  activityId    Int    @map("activity_id")
  conditionText String @map("condition_text")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_conditions")
}

model ActivityBenefit {
  id          Int    @id @default(autoincrement())
  activityId  Int    @map("activity_id")
  benefitText String @map("benefit_text")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_benefits")
}

model ActivitySoftSkill {
  id         Int    @id @default(autoincrement())
  activityId Int    @map("activity_id")
  skillName  String @map("skill_name") @db.VarChar(100)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_soft_skills")
}

model Registration {
  id           Int                @id @default(autoincrement())
  activityId   Int                @map("activity_id")
  studentId    Int                @map("student_id")
  registerDate DateTime           @default(now()) @map("register_date")
  status       RegistrationStatus @default(pending)
  attendance   AttendanceStatus   @default(absent)
  checkInTime  DateTime?          @map("check_in_time")

  activity    Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificate Certificate?
  evaluation  Evaluation?

  @@map("registrations")
}

model Certificate {
  id               Int      @id @default(autoincrement())
  registrationId   Int      @unique @map("registration_id")
  issueDate        DateTime @default(now()) @map("issue_date")
  certificateUrl   String   @map("certificate_url") @db.VarChar(255)
  verificationCode String?  @unique @map("verification_code") @db.VarChar(20)

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  ownerId    Int       @map("owner_id")
  label      String    @db.VarChar(100)
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix  String    @map("key_prefix") @db.VarChar(12)
  rateLimit  Int       @default(60) @map("rate_limit")
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model SiteContent {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  title       String?  @db.VarChar(255)
  body        String?
  updatedById Int?     @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_contents")
}

model Evaluation {
  id             Int      @id @default(autoincrement())
  registrationId Int      @unique @map("registration_id")
  evaluatorId    Int      @map("evaluator_id")
  teamwork       Int      @default(0)
  leadership     Int      @default(0)
  communication  Int      @default(0)
  problemSolving Int      @default(0) @map("problem_solving")
  adaptability   Int      @default(0)
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  evaluator    User         @relation(fields: [evaluatorId], references: [id])

  @@map("evaluations")
}
